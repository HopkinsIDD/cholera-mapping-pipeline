FROM rocker/tidyverse:4.2
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    libssl-dev  \ 
    libcurl4-openssl-dev \
    libxml2-dev \
    iputils-ping \
    libproj-dev \
    libgdal-dev \
    libglpk-dev \
    libudunits2-dev \
    libgeos-dev \
	build-essential \
	libv8-dev \
    postgresql-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
    
    
RUN R -e "install.packages('RPostgreSQL', type='source', dependencies=TRUE)"
RUN R -e "install.packages(c('ISOcodes'), dependencies=TRUE, repos='https://cloud.r-project.org/')"
RUN R -e "install.packages('s2', dependencies=TRUE)"
RUN R -e "install.packages('sf', dependencies=TRUE)"
RUN R -e "install.packages('geodata', dependencies=TRUE)"
RUN R -e "install.packages('igraph', dependencies=TRUE)"
RUN R -e "install.packages('optparse', dependencies=TRUE)"
RUN R -e "install.packages(c('spdep', 'foreach', 'doParallel', 'itertools'), repos='https://cloud.r-project.org/')"
# Install rstan with optimized compilation settings
RUN R -e "install.packages('rstan')"
CMD ["bash"]
