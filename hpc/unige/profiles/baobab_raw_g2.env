# Global database (aoi: raw) on Baobab, population from WorldPop Global 2
# (2015-2030), built 19-20 November 2026. Its paths carry a _g2 suffix so they
# stay apart from the Burundi test cluster that uses the default paths in
# $SHARE (pgdata/, Layers/, sif/, secrets/, db_endpoint).
#
# Use: export CMP_PROFILE=baobab_raw_g2, then source hpc/unige/env.sh or
# submit any job (jobs inherit the variable). Loaded by env.sh after SHARE is
# set; every value is a default, so a variable exported beforehand wins.

umask 007   # files stay readable and writable by the project group

export CMP_AOI="${CMP_AOI:-raw}"                    # database cholera_covariates_raw
export CMP_LAYERS="${CMP_LAYERS:-$SHARE/Layers_g2}"
export CHOLERA_MASTER_GRID_FILE="${CHOLERA_MASTER_GRID_FILE:-$CMP_LAYERS/worldpop_g2_raw/global_pop_2020_UC_1km_R2024B_UA_v1.tif}"
export CHOLERA_SIF="${CHOLERA_SIF-$SHARE/sif_g2/postgis_17-3.5.sif}"
export CMP_SECRETS="${CMP_SECRETS:-$SHARE/secrets_g2}"
export PGDATA="${PGDATA:-$SHARE/pgdata_g2/cholera_covariates}"
export PG_LOG="${PG_LOG:-$SHARE/logs_g2/postgres}"
export DB_ENDPOINT_FILE="${DB_ENDPOINT_FILE:-$SHARE/db_endpoint_g2}"
export DB_STOP_FILE="${DB_STOP_FILE:-$SHARE/db_stop_requested_g2}"
export CMP_BACKUPS="${CMP_BACKUPS:-$SHARE/backups_g2}"
export CMP_DIAGNOSTICS="${CMP_DIAGNOSTICS:-$SHARE/diagnostics_g2}"
